# ThreatScope training signatures. These rules only process the bundled/uploaded PCAP offline.
alert http any any -> any any (msg:"ThreatScope synthetic export path"; http.uri; content:"/export/"; sid:900001; rev:1;)
alert tcp any any -> any 80 (msg:"ThreatScope synthetic SYN sweep"; flags:S; threshold:type both, track by_src, count 12, seconds 60; sid:900002; rev:1;)
