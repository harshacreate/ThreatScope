# ThreatScope configuration. Copy to .env and adjust; every value has a safe default.

# Interface and port for `make run` / `python -m threatscope.app`.
# Keep 127.0.0.1 outside Docker; the container sets 0.0.0.0 and Compose binds the
# published port to 127.0.0.1:8103.
HOST=127.0.0.1
PORT=8000

# Python logging level for access/error logs
LOG_LEVEL=INFO

# Set to 0 to disable the ZAP panel (e.g. when the ZAP container is not running)
THREATSCOPE_ZAP_ENABLED=1

# Optional: require `Authorization: Bearer <token>` on every /api/ route (e.g. when the
# dashboard is shared on a lab network). Leave empty for single-analyst loopback use.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
THREATSCOPE_API_TOKEN=
